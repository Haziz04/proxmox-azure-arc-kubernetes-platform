# Terraform local working directory
.terraform/

# Terraform state - may contain sensitive data
*.tfstate
*.tfstate.*

# Environment-specific / secret variable values
*.tfvars
*.tfvars.json

# Terraform plan files
*.tfplan
tfplan

# Crash/debug output
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
